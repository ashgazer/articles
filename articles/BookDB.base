properties:
  file.name:
    displayName: name
views:
  - type: cards
    name: CardView
    filters:
      and:
        - file.folder == "BookDB"
    order:
      - title
      - author
      - Total Pages
    image: note.cover
    imageAspectRatio: 1
    cardSize: 230
    imageFit: contain
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "BookDB"
    order:
      - title
      - author
      - file.ctime
      - cover
