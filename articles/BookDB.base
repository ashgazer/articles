properties:
  file.name:
    displayName: name
views:
  - type: cards
    name: CardView
    filters:
      and:
        - file.folder == "BookDB"
        - read == false
        - electronic == false
    order:
      - title
      - author
      - Total Pages
    sort:
      - property: author
        direction: ASC
    image: note.cover
    imageAspectRatio: 1.55
    cardSize: 150
    imageFit: contain
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "BookDB"
    order:
      - title
      - author
      - read
      - electronic
      - file.ctime
      - cover
      - Publisher
      - Categories
    sort:
      - property: Publisher
        direction: ASC
